rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isSuperAdmin(){return signedIn() && request.auth.uid == "oqgmvKDsJQc7WdDcjOVi5YIohAj1";}
  function staffExists(){return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));}
  function staffData(){return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;}
  function isActiveCounsellor(){return staffExists() && staffData().active == true && staffData().role in ["counsellor","super_admin"];}
  function serviceAllowed(serviceName){return isSuperAdmin() || (isActiveCounsellor() && serviceName in staffData().services);}
  function assignedToMe(data){return isActiveCounsellor() && data.assignedCounsellorUid == request.auth.uid && serviceAllowed(data.applicationType);}
  match /users/{userId}{
   allow read: if isSuperAdmin() || (signedIn() && request.auth.uid==userId) || (signedIn() && resource.data.role=="client" && resource.data.accountStatus=="active" && resource.data.assignedCounsellorUid==request.auth.uid && serviceAllowed(resource.data.serviceType));
   allow create: if isSuperAdmin() || (signedIn() && request.auth.uid==userId && request.resource.data.keys().hasOnly(["fullName","email","phone","serviceType","assignedCounsellorUid","assignedCounsellorName","assignedCounsellorDesignation","role","accountStatus","createdAt","authProvider","legalAcceptance"]) && request.resource.data.fullName is string && request.resource.data.fullName.size()>0 && request.resource.data.email==request.auth.token.email && request.resource.data.phone is string && request.resource.data.phone.size()>0 && request.resource.data.serviceType in ["study_abroad","tourism"] && request.resource.data.role=="client" && request.resource.data.assignedCounsellorUid=="" && request.resource.data.assignedCounsellorName=="" && request.resource.data.assignedCounsellorDesignation=="" && request.resource.data.accountStatus=="active" && request.resource.data.createdAt is timestamp && request.resource.data.authProvider is list && request.resource.data.legalAcceptance is map && request.resource.data.legalAcceptance.keys().hasOnly(["termsVersion","privacyVersion","acceptedAt","method"]) && request.resource.data.legalAcceptance.termsVersion is string && request.resource.data.legalAcceptance.termsVersion=="2026-11-17-v1" && request.resource.data.legalAcceptance.privacyVersion=="2026-11-17-v1" && request.resource.data.legalAcceptance.acceptedAt==request.time && request.resource.data.legalAcceptance.method=="email_password_signup" && !exists(/databases/$(database)/documents/staff/$(userId)));
   allow update: if isSuperAdmin() || (signedIn() && request.auth.uid==userId && resource.data.role=="client" && resource.data.accountStatus=="active" && request.resource.data.role==resource.data.role && request.resource.data.accountStatus==resource.data.accountStatus && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fullName","email","phone","authProvider","updatedAt"]));
   allow delete: if isSuperAdmin();
  }
  match /staff/{staffUid}{
   allow read: if isSuperAdmin() || (signedIn() && request.auth.uid==staffUid);
   allow create,update,delete: if isSuperAdmin();
  }
  match /applications/{applicationId}{
   allow read: if isSuperAdmin() || (signedIn() && resource.data.clientUid==request.auth.uid) || assignedToMe(resource.data);
   allow create: if isSuperAdmin() || (signedIn()
    && request.resource.data.keys().hasOnly(["clientUid","applicantFullName","applyingFor","applicationType","assignedCounsellorUid","assignedCounsellorName","assignedCounsellorDesignation","status","progressStatus","progressUpdate","formVersion","formData","questionnaireStatus","createdAt","updatedAt"])
    && request.resource.data.clientUid==request.auth.uid
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=="client"
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus=="active"
    && request.resource.data.applicationType==get(/databases/$(database)/documents/users/$(request.auth.uid)).data.serviceType
    && request.resource.data.applicationType in ["study_abroad","tourism"]
    && request.resource.data.assignedCounsellorUid==""
    && request.resource.data.assignedCounsellorName==""
    && request.resource.data.assignedCounsellorDesignation==""
   
    && request.resource.data.applicantFullName is string
    && request.resource.data.applicantFullName.size()>0
    && request.resource.data.status=="registered"
    && request.resource.data.progressStatus=="registered"
    && request.resource.data.formData is map
    && request.resource.data.formVersion==1
    && request.resource.data.questionnaireStatus=="not_started");
   allow update: if isSuperAdmin()
    || (signedIn() && resource.data.clientUid==request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["applicantFullName","applyingFor","formData","questionnaireStatus","questionnaireUpdatedAt","updatedAt"])
      && request.resource.data.applicantFullName is string
      && request.resource.data.applicantFullName.size()>0
      && request.resource.data.formData is map
      && request.resource.data.questionnaireStatus in ["draft","completed"]
      && request.resource.data.applicationType==resource.data.applicationType
      && request.resource.data.status==resource.data.status
      && request.resource.data.assignedCounsellorUid==resource.data.assignedCounsellorUid
      && request.resource.data.progressStatus==resource.data.progressStatus)
    || (assignedToMe(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["progressStatus","progressUpdate","lastProgressUpdatedAt","updatedAt","universityDetails","activeProgressCycleId","progressCycleNumber"]) && request.resource.data.progressStatus in ["registered","submitted","under_review","counselling_scheduled","profile_assessment","documents_pending","documents_under_review","university_shortlisting","shortlist_shared","university_application","application_preparation","application_submitted","application_under_review","additional_information_requested","offer_received","offer_conditions_pending","offer_accepted","deposit_pending","deposit_paid","visa_documentation","visa_appointment_scheduled","visa_submitted","visa_decision","pre_departure","travel_ready","consultation_scheduled","requirements_review","itinerary_planning","itinerary_shared","quotation_shared","booking_confirmation_pending","bookings_confirmed","trip_in_progress","trip_completed","awaiting_client","on_hold","completed"] && request.resource.data.progressUpdate is string && request.resource.data.progressUpdate.size()>0 && request.resource.data.lastProgressUpdatedAt is timestamp && request.resource.data.updatedAt is timestamp && (!("universityDetails" in request.resource.data) || request.resource.data.universityDetails is map));
   allow delete: if isSuperAdmin();
  }
  match /status_updates/{updateId}{
   function linkedApplication(){return get(/databases/$(database)/documents/applications/$(resource.data.applicationId)).data;}
   allow create: if isSuperAdmin() || (signedIn() && request.resource.data.keys().hasOnly(["applicationId","clientUid","assignedCounsellorUid","applicationType","createdByUid","status","clientMessage","universityDetails","hiddenFromClient","createdAt"]) && request.resource.data.applicationId is string && request.resource.data.createdByUid==request.auth.uid && request.resource.data.assignedCounsellorUid==request.auth.uid && request.resource.data.clientUid==get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.clientUid && request.resource.data.applicationType==get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.applicationType && request.resource.data.status is string && request.resource.data.clientMessage is string && request.resource.data.clientMessage.size()>0 && request.resource.data.hiddenFromClient==false && request.resource.data.createdAt is timestamp && assignedToMe(get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data));
   allow read: if isSuperAdmin() || (signedIn() && resource.data.clientUid==request.auth.uid) || (signedIn() && resource.data.assignedCounsellorUid==request.auth.uid && serviceAllowed(resource.data.applicationType) && assignedToMe(linkedApplication()));
   allow update,delete: if isSuperAdmin();
  }
  match /progress_cycles/{cycleId}{
   function linkedApplication(){return get(/databases/$(database)/documents/applications/$(resource.data.applicationId)).data;}
   allow create: if isSuperAdmin() || (signedIn() && request.resource.data.createdByUid==request.auth.uid && request.resource.data.clientUid==get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.clientUid && assignedToMe(get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data));
   allow read: if isSuperAdmin() || (signedIn() && resource.data.clientUid==request.auth.uid) || (signedIn() && resource.data.assignedCounsellorUid==request.auth.uid && serviceAllowed(resource.data.applicationType));
   allow update: if isSuperAdmin() || (signedIn() && assignedToMe(linkedApplication()) && request.resource.data.status=="archived" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","archivedAt","archivedByUid","archiveReason"]));
   allow delete: if isSuperAdmin();
  }
  match /internal_notes/{noteId}{
   function linkedApplication(){return get(/databases/$(database)/documents/applications/$(resource.data.applicationId)).data;}
   allow create: if isSuperAdmin() || (signedIn() && request.resource.data.keys().hasOnly(["applicationId","clientUid","assignedCounsellorUid","applicationType","createdByUid","note","createdAt"]) && request.resource.data.createdByUid==request.auth.uid && request.resource.data.assignedCounsellorUid==request.auth.uid && request.resource.data.clientUid==get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.clientUid && request.resource.data.applicationType==get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.applicationType && request.resource.data.note is string && request.resource.data.note.size()>0 && request.resource.data.createdAt is timestamp && assignedToMe(get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data));
   allow read: if isSuperAdmin() || (signedIn() && resource.data.assignedCounsellorUid==request.auth.uid && serviceAllowed(resource.data.applicationType) && assignedToMe(get(/databases/$(database)/documents/applications/$(resource.data.applicationId)).data));
   allow update,delete: if isSuperAdmin();
  }
  match /follow_ups/{followUpId}{
   function linkedApplication(){return get(/databases/$(database)/documents/applications/$(resource.data.applicationId)).data;}
   allow create: if isSuperAdmin() || (signedIn() && request.resource.data.keys().hasOnly(["applicationId","clientUid","assignedCounsellorUid","applicationType","createdByUid","followUpDate","action","status","createdAt","updatedAt"]) && request.resource.data.createdByUid==request.auth.uid && request.resource.data.assignedCounsellorUid==request.auth.uid && request.resource.data.clientUid==get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.clientUid && request.resource.data.applicationType==get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.applicationType && request.resource.data.followUpDate is string && request.resource.data.action is string && request.resource.data.action.size()>0 && request.resource.data.status=="pending" && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp && assignedToMe(get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data));
   allow read: if isSuperAdmin() || (signedIn() && resource.data.assignedCounsellorUid==request.auth.uid && serviceAllowed(resource.data.applicationType) && assignedToMe(get(/databases/$(database)/documents/applications/$(resource.data.applicationId)).data));
   allow update: if isSuperAdmin() || (signedIn() && resource.data.assignedCounsellorUid==request.auth.uid && serviceAllowed(resource.data.applicationType) && assignedToMe(get(/databases/$(database)/documents/applications/$(resource.data.applicationId)).data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","followUpDate","action","completedAt","updatedAt"]) && request.resource.data.status in ["pending","completed"] && request.resource.data.updatedAt is timestamp);
   allow delete: if isSuperAdmin();
  }
  match /{document=**}{allow read,write: if isSuperAdmin();}
 }
}