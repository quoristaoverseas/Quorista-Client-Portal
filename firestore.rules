rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isSuperAdmin(){return signedIn() && request.auth.uid == "oqgmvKDsJQc7WdDcjOVi5YIohAj1";}
  function staffExists(){return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));}
  function staffData(){return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;}
  function isActiveCounsellor(){return staffExists() && staffData().active == true && staffData().role in ["counsellor","super_admin"];}
  function serviceAllowed(service){return isSuperAdmin() || (isActiveCounsellor() && service in staffData().services);}
  function assignedToMe(data){return isActiveCounsellor() && data.assignedCounsellorUid == request.auth.uid && serviceAllowed(data.applicationType);}
  match /users/{userId}{
   allow read: if isSuperAdmin() || (signedIn() && request.auth.uid==userId);
   allow create: if isSuperAdmin() || (signedIn() && request.auth.uid==userId && request.resource.data.keys().hasOnly(["fullName","email","role","accountStatus","createdAt","authProvider"]) && request.resource.data.fullName is string && request.resource.data.fullName.size()>0 && request.resource.data.email==request.auth.token.email && request.resource.data.role=="client" && request.resource.data.accountStatus=="active" && request.resource.data.createdAt is timestamp && request.resource.data.authProvider is list);
   allow update: if isSuperAdmin() || (signedIn() && request.auth.uid==userId && resource.data.role=="client" && resource.data.accountStatus=="active" && request.resource.data.role==resource.data.role && request.resource.data.accountStatus==resource.data.accountStatus && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fullName","email","authProvider","updatedAt"]));
   allow delete: if isSuperAdmin();
  }
  match /staff/{staffUid}{
   allow read: if isSuperAdmin() || (signedIn() && request.auth.uid==staffUid);
   allow create,update,delete: if isSuperAdmin();
  }
  match /applications/{applicationId}{
   allow read: if isSuperAdmin() || (signedIn() && resource.data.clientUid==request.auth.uid) || assignedToMe(resource.data);
   allow create: if isSuperAdmin() || (signedIn() && request.resource.data.keys().hasOnly(["clientUid","applicantFullName","applyingFor","applicationType","status","formVersion","formData","createdAt","updatedAt"]) && request.resource.data.clientUid==request.auth.uid && request.resource.data.applicantFullName is string && request.resource.data.applicantFullName.size()>0 && request.resource.data.applicationType=="study_abroad" && request.resource.data.status in ["draft","submitted"] && request.resource.data.formData is map && request.resource.data.formVersion==1);
   allow update: if isSuperAdmin()
    || (signedIn() && resource.data.clientUid==request.auth.uid && resource.data.status=="draft" && request.resource.data.clientUid==resource.data.clientUid && request.resource.data.applicationType==resource.data.applicationType && request.resource.data.status in ["draft","submitted"] && request.resource.data.createdAt==resource.data.createdAt && request.resource.data.keys().hasOnly(["clientUid","applicantFullName","applyingFor","applicationType","status","formVersion","formData","createdAt","updatedAt"]))
    || (assignedToMe(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["progressStatus","progressUpdate","lastProgressUpdatedAt","updatedAt"]));
   allow delete: if isSuperAdmin();
  }
  match /{document=**}{allow read,write: if isSuperAdmin();}
 }
}